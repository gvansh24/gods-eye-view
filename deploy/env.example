# Server-side config for the self-hosted instance.
# On the server: cp deploy/env.example .env && chmod 600 .env, then fill in keys.
# .env is gitignored and excluded from the Docker build context — never commit it.

# Required for the photorealistic 3D globe. Baked into the browser bundle
# (visible in devtools by design). In Google Cloud restrict it to:
#   HTTP referrer  http://92.4.88.247:8080/*   and   API  Map Tiles API
# and set a billing budget alert.
GOOGLE_MAPS_API_KEY=

# Optional, also client-exposed: use a public assets:read token with URL restrictions.
# CESIUM_ION_TOKEN=

# Flights without OpenSky credentials (rate-limited but works).
OPENSKY_AUTH_MODE=anon

# Behind the nginx gateway every visitor shares one socket IP, so these act as
# GLOBAL per-minute caps on the paid endpoints — a spend guard for a public instance.
GEV_RATELIMIT_GOOGLE_PER_MIN=60
GEV_RATELIMIT_OPENAI_PER_MIN=10

# Leave OpenAI unset while the site is plain HTTP: browsers block the microphone,
# so voice can't work for visitors, but /api/realtime/token would still mint
# paid sessions for anyone who calls it.
# OPENAI_API_KEY=

# Free keys that light up more layers (all stay server-side):
# AISSTREAM_API_KEY=
# FIRMS_MAP_KEY=
# TOMTOM_API_KEY=
