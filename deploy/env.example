# Server-side config for the public self-hosted instance.
# On the server: cp deploy/env.example .env && chmod 600 .env
# .env is gitignored and in upstream's .dockerignore — never commit it.
# After changing a key: push live or re-run the deploy, because client tokens are
# baked in at build time.

# Optional: the photorealistic 3D globe and Street View. Without it the app uses
# free Esri imagery. Baked into the browser bundle, so anyone can read it. In
# Google Cloud restrict it to:
#   HTTP referrer  http://92.4.88.247:8080/*
#   APIs           Map Tiles API (add Maps JavaScript API only for Street View)
# and set a billing budget alert and daily quotas BEFORE adding it.
GOOGLE_MAPS_API_KEY=

# Optional, also client-exposed: restrict by URL at the provider.
# CESIUM_ION_TOKEN=
# MAPILLARY_CLIENT_TOKEN=

# Flights without OpenSky credentials (rate-limited but works).
OPENSKY_AUTH_MODE=anon

# Free keys that light up more layers (server-side):
# AISSTREAM_API_KEY=
# FIRMS_MAP_KEY=

# Do not add these while this instance is public. Requests through the gateway
# carry forwarding headers, so upstream's gate refuses the routes that spend them
# (403): they would add no feature, only a secret on a public machine.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_MAPS_SERVER_API_KEY=
# TOMTOM_API_KEY=
